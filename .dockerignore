# Dependencies and build output are produced inside the image.
**/node_modules
**/dist

# Secrets never enter a layer: backend/.env holds JWT and admin credentials.
.env
.env.*
**/.env
**/.env.*

# Local databases, journals and Prisma artefacts.
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# VCS, editor and OS clutter.
**/.git
**/.gitignore
**/.github
**/.vscode
**/.idea
**/.DS_Store

# Logs and coverage from local runs.
**/*.log
**/npm-debug.log*
**/coverage
