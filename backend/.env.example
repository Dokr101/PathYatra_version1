# Copy to .env and fill in real values.
# SQLite for local dev. To move to Postgres, change this line plus the
# datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -hex 32
# This file holds placeholders only. The API refuses to boot while JWT_SECRET or
# ADMIN_SEED_PASSWORD still equal the values below — see "Secrets and rotation"
# in README.md.
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"

PORT=3001

# Reverse proxies in front of the API. 0 = reached directly (local dev),
# 1 = one nginx/ALB layer, 2 = CDN + load balancer, and so on.
# Rate limiting, req.ip and the Secure-cookie/HSTS decisions depend on it:
# too low and every visitor shares the proxy's address, too high and clients
# can spoof X-Forwarded-For. The API must only be reachable through the proxy.
TRUST_PROXY_HOPS="1"

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Production must list only the real site origin, e.g. https://pathyatra.example.com
ALLOWED_ORIGINS="http://localhost:3000"

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Sentry error reporting (optional). Empty disables it: no client is created and
the process makes no network calls. DSN comes from the Sentry project's client
keys for a Node.js project. Set SENTRY_RELEASE too to tie errors to a deploy.
SENTRY_DSN=""

# bcrypt cost factor for password hashes. OWASP's floor for bcrypt is 12; each
# step doubles the work an attacker needs per stolen hash. Raising it does not
# rewrite stored hashes — they upgrade on the next successful sign-in. Lower it
# only for tests or very small machines.
BCRYPT_ROUNDS="12"

# Admin panel bootstrap: run `npm run seed:admin` after setting these.
# 12+ characters, unique to this deployment, never reused from the template.
ADMIN_SEED_EMAIL="you@example.com"
ADMIN_SEED_PASSWORD="use-a-long-random-password"
ADMIN_SEED_NAME="PathYatra Admin"

# Cloudinary (free tier) for admin image uploads. Optional in local dev.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="pathyatra"
