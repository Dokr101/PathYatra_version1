# Copy to .env and fill in real values.
# SQLite for local dev. To move to Postgres, change this line plus the
# datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"

PORT=3001

# Admin panel bootstrap: run `npm run seed:admin` after setting these.
ADMIN_SEED_EMAIL="you@example.com"
ADMIN_SEED_PASSWORD="use-a-long-random-password"
ADMIN_SEED_NAME="PathYatra Admin"

# Cloudinary (free tier) for admin image uploads. Optional in local dev.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="pathyatra"
