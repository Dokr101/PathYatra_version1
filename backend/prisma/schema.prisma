// PathYatra data model.
// Local dev uses SQLite. To move to Postgres later, change the provider below
// and DATABASE_URL in backend/.env — no application code changes are needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum ActivityType {
  ACTIVITY
  ATTRACTION
}

enum PlaceType {
  HOTEL
  RESTAURANT
}

enum TravelInfoStatus {
  VERIFIED
  ESTIMATE
  GENERAL_GUIDANCE
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  /// Bumped on password change; tokens carrying an older version are rejected.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  itineraries Itinerary[]
  favorites   Favorite[]
  reviews     Review[]
  auditLogs   AuditLog[]
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  destinations Destination[]
}

model Destination {
  id                      String        @id @default(cuid())
  categoryId              String
  category                Category      @relation(fields: [categoryId], references: [id])
  name                    String
  slug                    String        @unique
  province                String?
  district                String?
  shortDescription        String?
  overview                String?
  highlights              String?
  localFood               String?
  travelEssentials        String?
  bestSeason              String?
  recommendedDurationDays Int?
  difficultyLevel         String        @default("easy")
  costPerPersonPerDay     Float?
  latitude                Float?
  longitude               Float?
  imagePath               String?
  status                  ContentStatus @default(DRAFT)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now()) @updatedAt

  itineraries Itinerary[]
  favorites   Favorite[]
  reviews     Review[]
  images      DestinationImage[]
  activities  Activity[]
  places      Place[]
  travelInfo  TravelInfo[]
  templates   ItineraryTemplate[]
}

model DestinationImage {
  id            String       @id @default(cuid())
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  url           String
  publicId      String
  altText       String?
  caption       String?
  credit        String?
  isCover       Boolean      @default(false)
  sortOrder     Int          @default(0)
  width         Int?
  height        Int?
  createdAt     DateTime     @default(now())

  @@index([destinationId])
}

model Activity {
  id             String        @id @default(cuid())
  destinationId  String
  destination    Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name           String
  type           ActivityType  @default(ACTIVITY)
  description    String?
  durationHours  Float?
  costEstimate   Float?
  costUpdatedAt  DateTime?
  difficulty     String?
  bestSeason     String?
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([destinationId])
}

model Place {
  id            String        @id @default(cuid())
  destinationId String
  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  type          PlaceType     @default(HOTEL)
  description   String?
  address       String?
  phone         String?
  website       String?
  priceRange    String?
  amenities     String?
  latitude      Float?
  longitude     Float?
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([destinationId])
}

model ItineraryTemplate {
  id             String        @id @default(cuid())
  destinationId  String?
  destination    Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  title          String
  slug           String        @unique
  summary        String?
  difficulty     String?
  durationDays    Int           @default(1)
  estimatedCost  Float?
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  days           TemplateDay[]

  @@index([destinationId])
}

model TemplateDay {
  id          String          @id @default(cuid())
  templateId  String
  template    ItineraryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String?
  stops       TemplateStop[]

  @@unique([templateId, dayNumber])
}

model TemplateStop {
  id            String      @id @default(cuid())
  dayId         String
  day           TemplateDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  timeSlot      String?
  title         String
  description   String?
  estimatedCost Float?
  sortOrder     Int         @default(0)
}

model TravelInfo {
  id             String           @id @default(cuid())
  destinationId  String
  destination    Destination      @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title          String
  category       String?
  content        String
  sourceName     String?
  sourceUrl      String?
  lastVerifiedAt DateTime?
  validFrom      DateTime?
  validUntil     DateTime?
  statusLabel    TravelInfoStatus @default(GENERAL_GUIDANCE)
  status         ContentStatus    @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([destinationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
}

model SiteSetting {
  id                     String   @id @default("singleton")
  siteName               String   @default("PathYatra")
  contactEmail           String?
  contactPhone           String?
  featuredDestinationIds String   @default("[]")
  updatedAt              DateTime @updatedAt
}

model Itinerary {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  destinationId String
  destination   Destination    @relation(fields: [destinationId], references: [id])
  title         String
  startingPoint String?
  startDate     DateTime?
  endDate       DateTime?
  numTravelers  Int            @default(1)
  totalBudget   Float?
  status        String         @default("draft")
  /// Rich client plan (route, costs, packing, notes) that has no relational home.
  clientPlan    String?
  createdAt     DateTime       @default(now())
  days          ItineraryDay[]
}

model ItineraryDay {
  id          String          @id @default(cuid())
  itineraryId String
  itinerary   Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  dayDate     DateTime?
  notes       String?
  stops       ItineraryStop[]
}

model ItineraryStop {
  id            String       @id @default(cuid())
  dayId         String
  day           ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  timeSlot      String
  title         String
  description   String?
  estimatedCost Float?
  sortOrder     Int          @default(0)
}

model Favorite {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@unique([userId, destinationId])
}

model Review {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  destinationId  String
  destination    Destination  @relation(fields: [destinationId], references: [id])
  rating         Int
  comment        String?
  travelDate     DateTime?
  status         ReviewStatus @default(PENDING)
  moderationNote String?
  moderatedAt    DateTime?
  moderatedById  String?
  createdAt      DateTime     @default(now())

  /// One review per traveller per destination: the database, not just the API,
  /// refuses a flooded moderation queue.
  @@unique([userId, destinationId])
  @@index([destinationId])
  @@index([status])
}
